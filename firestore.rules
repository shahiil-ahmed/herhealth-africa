rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /{path=**}/bookings/{bookingId} {
      allow read, update: if isAdmin();
    }
    
    // Core user data rule: users can read/write their own document
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Subcollections under user (dailyLogs, bookings, profile)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Specialists directory: read-only for authenticated users
    match /specialists/{specialistId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
    
    // Nominations: users can submit
    match /nominations/{nominationId} {
      allow create: if request.auth != null && request.resource.data.submittedBy == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    
    // Wins community board
    match /wins/{winId} {
      // Any authenticated user can read
      allow read: if request.auth != null;
      
      // Users can post wins as themselves
      allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;
      
      // Users can update wins to add their ID to the celebrations array, but they cannot alter the text or author
      allow update: if request.auth != null 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['celebrations'])
                    && request.resource.data.text == resource.data.text
                    && request.resource.data.senderUid == resource.data.senderUid;
      
      // Deletion is allowed if the user owns the win
      allow delete: if request.auth != null && resource.data.senderUid == request.auth.uid;
    }
    
    // Chats community circles
    match /chats/{circleId}/messages/{messageId} {
      // Any authenticated user can read
      allow read: if request.auth != null;
      
      // Users can post messages as themselves
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      
      // Users can delete their own messages
      allow delete: if request.auth != null && resource.data.senderId == request.auth.uid;
      
      // Updates are not supported for chat messages
      allow update: if false;
    }
  }
}
